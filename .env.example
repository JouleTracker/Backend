# Server Port
PORT=8081

# Database Configuration
DB_URL=jdbc:mysql://127.0.0.1:3306/jouletracker_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=change_me_db_password

# JWT Security (minimum 32 characters for HS256)
JWT_SECRET=change_me_super_secret_jwt_key_at_least_32_chars_long
JWT_EXPIRATION_DAYS=7

# Brevo Transactional Email Service
BREVO_API_KEY=xkeysib-change_me_brevo_api_key
BREVO_SENDER_EMAIL=jouletacker@gmail.com
BREVO_SENDER_NAME=JouleTracker Platform
BREVO_API_URL=https://api.brevo.com/v3/smtp/email

# Frontend Integration
FRONTEND_BASE_URL=http://localhost:4200
EMAIL_VERIFICATION_URL=http://localhost:4200/verify-email

# IAM Verification Token Validity
IAM_VERIFICATION_TOKEN_VALIDITY_HOURS=24