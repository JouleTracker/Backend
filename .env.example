# Server Port
PORT=8081

# Supabase (PostgreSQL) Database Configuration
DB_URL=jdbc:postgresql://aws-0-us-east-2.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.your_supabase_project_ref
DB_PASSWORD=change_me_supabase_db_password
JPA_DDL_AUTO=update

# JWT Security (minimum 32 characters for HS256)
JWT_SECRET=change_me_super_secret_jwt_key_at_least_32_chars_long
JWT_EXPIRATION_DAYS=7

# Brevo Transactional Email Service
BREVO_API_KEY=xkeysib-change_me_brevo_api_key
BREVO_SENDER_EMAIL=no-reply@jouletracker.com
BREVO_SENDER_NAME=JouleTracker Platform
BREVO_API_URL=https://api.brevo.com/v3/smtp/email

# Frontend Integration (mandatory for verification and password reset links)
FRONTEND_BASE_URL=http://localhost:4200
# Optional explicit overrides (defaults to ${FRONTEND_BASE_URL}/verify-email and ${FRONTEND_BASE_URL}/reset-password)
EMAIL_VERIFICATION_URL=http://localhost:4200/verify-email
PASSWORD_RESET_URL=http://localhost:4200/reset-password

# IAM Token Validity Settings
IAM_VERIFICATION_TOKEN_VALIDITY_HOURS=24
IAM_PASSWORD_RESET_TOKEN_VALIDITY_MINUTES=30
